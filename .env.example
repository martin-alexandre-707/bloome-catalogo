# Chave de assinatura da sessão do Flask.
# Gere uma nova com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Banco PostgreSQL (obrigatório — sem ele o app não inicia).
# Local:
#   postgresql://postgres:SUA_SENHA@localhost:5432/bloome
# Supabase (copie em Project Settings > Database > Connection string):
#   postgresql://postgres.<ref>:SENHA@<host>:5432/postgres
DATABASE_URL=
